# Example only — do NOT copy values here and do NOT create this file by hand.
# `npm run collab:setup` writes the real `.env.local-backend.local` itself
# (git-ignored, mode 600) from YOUR OWN local Supabase on this Mac.
LOCAL_SUPABASE_URL=http://127.0.0.1:55421
LOCAL_SUPABASE_ANON_KEY=<generated by your local Supabase>
LOCAL_SUPABASE_SERVICE_ROLE_KEY=<generated by your local Supabase — never share>
LOCAL_DB_URL=postgresql://postgres:<generated>@127.0.0.1:55422/postgres
LOCAL_MAIL_URL=http://127.0.0.1:55424
