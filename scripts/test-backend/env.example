# Copy to  ~/tempa-p0/.env.test.local  (git-ignored) and fill in from the
# SEPARATE test project's Dashboard. Never put live-project values here.
#
# Settings → API
TEST_SUPABASE_URL=https://<test-project-ref>.supabase.co
TEST_SUPABASE_ANON_KEY=<anon / publishable key of the TEST project>
TEST_SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key of the TEST project — used only by the local seed/smoke scripts>
# Settings → Database → Connection string (URI, session pooler), password filled in
TEST_DB_URL=postgresql://postgres.<test-project-ref>:<password>@<pooler-host>:5432/postgres
